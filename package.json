{
  "name": "zmultica",
  "version": "0.13.6",
  "description": "ZMultica — a session-backed task board for Yuri",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.mjs",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:server && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src test scripts *.ts *.json README.md",
    "format:check": "prettier --check src test scripts *.ts *.json README.md",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "build:server": "esbuild src/server.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist/index.mjs --external:@opencode/plugin --external:@opencode/ai --external:effect --external:bun:sqlite"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.1",
    "@types/markdown-it": "^14.1.2",
    "effect": "4.0.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@opencode/client": "2.2.1",
    "@types/node": "^22.18.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "solid-js": "1.9.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  },
  "main": "./dist/index.mjs"
}
